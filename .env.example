# Copy this file to `.env` for local development.
# Keep real connection strings and API keys out of source control.

# Required. Used by Prisma and the app's database-backed API routes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional for normal app runtime.
# Recommended for local Prisma migration validation when using a separate disposable database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/SHADOW_DATABASE?sslmode=require"
